{
  "name": "jscov-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist reports node_modules/.cache",
    "test": "vitest run --no-file-parallelism --reporter=default --reporter=junit --outputFile.junit=build/test-results/test/report.xml --coverage.enabled --coverage.provider=istanbul --coverage.reporter=clover --coverage.reporter=html --coverage.reportsDirectory=build/reports/coverage && node scripts/normalize-junit-times.mjs build/test-results/test/report.xml",
    "test:run": "vitest run",
    "lint": "eslint src",
    "lint:report": "eslint src --format eslint-formatter-checkstyle --output-file build/reports/eslint/checkstyle.xml"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-formatter-checkstyle": "9.0.1",
    "globals": "^15.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  }
}
