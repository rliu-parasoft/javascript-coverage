{
  "name": "jscov-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:instrument": "vite build --mode instrument",
    "clean": "rimraf dist dist-dev build reports .parasoft node_modules/.cache",
    "test": "node scripts/run-tests.mjs",
    "test:run": "vitest run --no-file-parallelism",
    "lint": "eslint src",
    "lint:report": "eslint src --format eslint-formatter-checkstyle --output-file build/reports/eslint/checkstyle.xml"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "express": "^5.2.1",
    "i18next": "26.4.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-source-maps": "~5.0.6",
    "jsonc-parser": "3.3.1",
    "winston": "3.19.0",
    "yargs-parser": "^22.0.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/yargs-parser": "^21.0.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.0.0",
    "eslint-formatter-checkstyle": "9.0.1",
    "globals": "^17.0.0",
    "istanbul-lib-instrument": "file:vendor/parasoft-istanbul-lib-instrument-6.0.3-1.tgz",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "minimatch": "^10.2.6"
  }
}
