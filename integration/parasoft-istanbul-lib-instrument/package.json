{
  "name": "parasoft-istanbul-lib-instrument",
  "version": "6.0.3-1",
  "description": "Parasoft JavaScript instrumentation library.",
  "author": "parasoft",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "nyc --reporter=clover --report-dir build/reports/coverage mocha --reporter xunit --reporter-option output=build/test-results/test/report.xml",
    "lint:report": "eslint -f eslint-formatter-checkstyle -o build/reports/eslint/checkstyle.xml \"src/**/*.js\""
  },
  "dependencies": {
    "@babel/core": "^7.23.9",
    "@babel/parser": "^7.23.9",
    "@istanbuljs/schema": "^0.1.3",
    "i18next": "26.4.3",
    "istanbul-lib-coverage": "^3.2.0",
    "istanbul-lib-source-maps": "~5.0.6",
    "semver": "^7.5.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@eslint/js": "^10.0.0",
    "chai": "^6.0.0",
    "clone": "^2.1.2",
    "debug": "^4.1.1",
    "eslint": "^10.0.0",
    "eslint-formatter-checkstyle": "9.0.1",
    "globals": "^17.0.0",
    "js-yaml": "^5.0.0",
    "mocha": "^12.0.1",
    "nopt": "^4.0.1",
    "nyc": "^18.0.0"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "coverage",
    "istanbul",
    "js",
    "instrumentation"
  ],
  "engines": {
    "node": ">=10"
  },
  "overrides": {
    "minimatch": "^10.2.6"
  }
