@Library('code-review-lib@chengdu') _

codeReviewPipeline(
    agentLabel: 'ai-reviewer',
    baseBranch: 'master',
    fileGlobs: [
        '**/*.java',
        '**/*.js',
        '**/*.jsx',
        '**/*.ts',
        '**/*.tsx',
        '**/*.mjs',
        '**/*.cjs'
    ],
    specFileGlobs: [
        'specs/*.md',
        'docs/design/*.md'
    ],
    includeSpecContents: true,
    model: 'gpt-5.6-terra',
    scmProvider: 'bitbucket',
    bitbucketBaseUrl: 'https://code.parasoftcn.com',
    projectKey: 'JSC',
    repoSlug: 'javascript-coverage',
    gitSshCredentialsId: 'bitbucket-code-ssh',
    bitbucketTokenCredentialId: 'code-reviewer-bitbucket',
    openAiCredentialId: 'code-reviewer-codex',
    personaFilePath: '.agents/agents/code-reviewer/agent.md',
    skillFilePath: '.agents/skills/code-review/skill.md',
    includeLocalReviewerGuides: true,
    requireLocalReviewerGuides: true,
    metadataMarkerPrefix: '<!-- jscov-code-review-meta:',
    reportDir: 'build/reports/oz'
)
