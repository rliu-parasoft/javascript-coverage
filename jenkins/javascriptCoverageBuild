/*
 * Configure these parameters in the Jenkins job UI:
 *
 * AGENT_LABEL: String
 * MAVEN_TOOL: String (Maven installation name or ID from Global Tool Configuration)
 * FILES_TO_UPLOAD: String
 * PUBLISH_TO_REPO: Boolean
 * IS_CHENGDU: Boolean
 * NOTIFY_RECIPIENTS: String
 *
 * Jenkins agent prerequisite when IS_CHENGDU is true:
 * $HOME/.netrc: DTP data collector credentials for dtp.parasoftcn.com
 */

def parseRecipientList(String rawRecipients) {
    def recipients = (rawRecipients ?: '')
        .split(/[,\s;]+/)
        .collect { it.trim() }
        .findAll { !it.isEmpty() }

    if (recipients.isEmpty()) {
        return []
    }

    def emailPattern = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/
    def invalidRecipients = recipients.findAll { !(it ==~ emailPattern) }
    if (!invalidRecipients.isEmpty()) {
        error("Invalid email recipients: ${invalidRecipients.join(', ')}")
    }

    return recipients.unique()
}

def extractFailureReason(String logPath) {
    if (!fileExists(logPath)) {
        return 'unknown'
    }

    for (String line : readFile(logPath).readLines()) {
        def matcher = (line =~ /(?i)^\s*(FAILURE:|ERROR:)\s*(.+)\s*$/)
        if (matcher.matches()) {
            return matcher[0][2].trim()
        }
    }

    return 'unknown'
}

pipeline {
    agent { label params.AGENT_LABEL }

    tools {
        maven params.MAVEN_TOOL
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Preflight') {
            steps {
                sh '''\
                    #!/usr/bin/env bash
                    set -e
                    command -v bash >/dev/null 2>&1 || { echo "ERROR: bash is required on this Jenkins agent."; exit 1; }
                    command -v java >/dev/null 2>&1 || { echo "ERROR: java is required on this Jenkins agent."; exit 1; }
                    command -v mvn >/dev/null 2>&1 || { echo "ERROR: Maven is required on this Jenkins agent."; exit 1; }
                    '''.stripIndent()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh '''\
                    #!/usr/bin/env bash
                    set -euo pipefail

                    chmod +x ./gradlew

                    # Refresh dependencies in the weekends
                    dayOfWeek=$(date +%A)
                    if [ "$dayOfWeek" == "Saturday" ]; then
                        export REFRESH_DEPENDENCIES="true"
                    elif [ "$dayOfWeek" == "Sunday" ]; then
                        export REFRESH_DEPENDENCIES="true"
                    fi

                    chmod +x ./gradlew
                    if [ "${REFRESH_DEPENDENCIES:-false}" = "true" ]; then
                      ./gradlew --refresh-dependencies clean dist 2>&1 | tee build.log
                    else
                      ./gradlew clean dist 2>&1 | tee build.log
                    fi
                    '''.stripIndent()
            }
        }

        stage('Generate SBOM') {
            steps {
                script {
                    // Always generate the merged SBOM json. sbom.sh derives the
                    // dtrack upload and wiki generation switches from IS_CHENGDU,
                    // so only the Chengdu flag needs to be forwarded here.
                    withEnv(["IS_CHENGDU=${params.IS_CHENGDU}"]) {
                        sh '''\
                            #!/usr/bin/env bash
                            set -euo pipefail

                            # Generate a single merged SBOM for the distribution using the
                            # reusable scripts extracted by sbom.sh into the top-level us/
                            # directory. The entry point runs three steps in order:
                            #   1. sbom_scan_java.sh : Java SBOM from parasoft-jscov.jar
                            #   2. sbom_scan_js.sh   : JS SBOM from each integration module
                            #   3. sbom_process.sh   : merge + dedup + fix + validate + upload + wiki

                            ./jenkins/scripts/sbom.sh
                            '''.stripIndent()
                    }
                }
            }
        }

        stage('Upload DTrack Report to Chengdu DTP') {
            when {
                expression {
                    return params.IS_CHENGDU
                }
            }
            steps {
                script {
                    sh '''\
                            #!/usr/bin/env bash
                            set -euo pipefail
                            set +x

                            command -v curl >/dev/null 2>&1 || { echo "ERROR: curl is required."; exit 1; }
                            command -v xmlstarlet >/dev/null 2>&1 || { echo "ERROR: xmlstarlet is required."; exit 1; }

                            DTRACK_REPORT_XML_URL="https://distros.parasoftcn.com/javascript-coverage/us-jenkins-job-results/dtrack-to-chengdu-dtp.xml"
                            DTRACK_REPORT_XML_FILE="build/dtrack-to-dtp/dtrack-to-chengdu-dtp.xml"
                            DTP_DATA_COLLECTOR_URL="https://dtp.parasoftcn.com:8082/api/v2/dataCollector"

                            get_report_build_id() {
                                xmlstarlet select --template --value-of "/ResultsSession/@buildId" "$1"
                            }

                            echo "Downloading dtrack report..."
                            mkdir -p "$(dirname "${DTRACK_REPORT_XML_FILE}")"
                            curl --output "${DTRACK_REPORT_XML_FILE}" -fsSL "${DTRACK_REPORT_XML_URL}"

                            echo "Updating buildId..."
                            ORIGINAL_DTRACK_REPORT_BUILD_ID="$(get_report_build_id "${DTRACK_REPORT_XML_FILE}")"
                            echo "Original buildId: ${ORIGINAL_DTRACK_REPORT_BUILD_ID}"

                            CURRENT_BUILD_REPORT_BUILD_ID="JavascriptCoverage-$(date +%Y-%m-%d)"
                            echo "Current buildId: ${CURRENT_BUILD_REPORT_BUILD_ID}"
                            xmlstarlet edit --inplace --update "/ResultsSession/@buildId" \
                                --value "${CURRENT_BUILD_REPORT_BUILD_ID}" "${DTRACK_REPORT_XML_FILE}"

                            NEW_DTRACK_REPORT_BUILD_ID="$(get_report_build_id "${DTRACK_REPORT_XML_FILE}")"
                            echo "New buildId: ${NEW_DTRACK_REPORT_BUILD_ID}"


                            echo "Uploading dtrack report to DTP..."
                            curl -fsSL --netrc --form "file=@${DTRACK_REPORT_XML_FILE}" "${DTP_DATA_COLLECTOR_URL}"

                            echo "Done."
                            '''.stripIndent()
                }
            }
        }

        stage('Upload') {
            when {
                expression {
                    return params.PUBLISH_TO_REPO
                }
            }
            steps {
                script {
                    if (params.IS_CHENGDU) {
                        sh '''\
                            #!/usr/bin/env bash
                            set -euo pipefail
                            set +x

                            command -v curl >/dev/null 2>&1 || { echo "ERROR: curl is required to publish artifacts."; exit 1; }
                            command -v tar >/dev/null 2>&1 || { echo "ERROR: tar is required to publish artifacts."; exit 1; }
                            command -v ssh >/dev/null 2>&1 || { echo "ERROR: ssh is required to publish artifacts."; exit 1; }

                            echo "Updating the fileserver scripts..."
                            curl -s https://distros.parasoftcn.com/fileserver-scripts.tar | tar x

                            fileserver_user_host="modtest@192.168.3.106"
                            fileserver_builds_dir="/home/modtest/dists/javascript-coverage/builds"
                            branch="${BRANCH_NAME:-${CHANGE_BRANCH:-$(git rev-parse --abbrev-ref HEAD)}}"
                            commit="$(git rev-parse HEAD)"

                            fileserver-scripts/create-build-and-upload.sh \
                              --user-host "${fileserver_user_host}" \
                              --builds-dir "${fileserver_builds_dir}" \
                              --branch "${branch}" \
                              --commit "${commit}" \
                              --build-name "$(date '+%Y-%m-%d')" \
                              --build-id "${BUILD_TAG}" \
                              --build-type snapshot \
                              --links-to latest_build \
                              --overwrite true \
                              -- \
                                $(echo "${FILES_TO_UPLOAD}" | tr "," " ") 2>&1 | tee upload.log

                            exitValue=$?

                            ssh "${fileserver_user_host}" "\
                              chmod 755 -R '${fileserver_builds_dir}'; \
                              cd '${fileserver_builds_dir}/latest_build'; \
                              /home/modtest/dists/ptest/scripts/auto-generate-htaccess.sh \
                              "

                            ssh "${fileserver_user_host}" "\
                              cleanup \
                                --path '${fileserver_builds_dir}' \
                                --days 20 \
                              "

                            exit $exitValue
                            '''.stripIndent()
                    } else {
                        sh '''\
                            #!/usr/bin/env bash
                            set -euo pipefail
                            set +x

                            command -v curl >/dev/null 2>&1 || { echo "ERROR: curl is required to publish artifacts."; exit 1; }
                            command -v tar >/dev/null 2>&1 || { echo "ERROR: tar is required to publish artifacts."; exit 1; }
                            command -v ssh >/dev/null 2>&1 || { echo "ERROR: ssh is required to publish artifacts."; exit 1; }
                            command -v git >/dev/null 2>&1 || { echo "ERROR: git is required to publish artifacts."; exit 1; }

                            export GIT_BRANCH="${BranchToBuild}"
                            export GIT_COMMIT="$(git rev-parse HEAD)"

                            # The script takes this as the BUILD_ID
                            export BUILD_TAG="javascript-coverage.$(date +%Y-%m-%d)"
                            export PROJECT_BUILD_DIR="javascript-coverage/${BranchToBuild}"

                            # Upload build to sponge
                            git archive --remote ssh://git@trove.parasoft.com:7999/help/fileserver-scripts.git master fileserver-scripts | tar x
                            ./fileserver-scripts/team-parasoft-findings/upload-build-to-sponge.sh 2>&1 | tee upload.log
                            '''.stripIndent()
                    }
                }
            }
        }

        stage('Trigger DTP') {
            when {
                expression {
                    return !params.IS_CHENGDU
                }
            }
            steps {
                build job: 'dtrack_to_dtp_trigger',
                      parameters: [
                          string(name: 'MAIN_FLAG', value: 'javascript-coverage')
                      ],
                      wait: false,
                      propagate: false
            }
        }
    }

    post {
        success {
            script {
                // Promote this successful build via the shared promoter job.
                // Chengdu builds are excluded from promotion.
                if (!params.IS_CHENGDU) {
                    build job: 'promoter',
                          parameters: [
                              string(name: 'PROMOTE_PRODUCT', value: 'javascript-coverage'),
                              string(name: 'PROMOTE_BRANCH', value: 'master'),
                              string(name: 'PROMOTE_BUILD_NAME', value: 'latest_build'),
                              booleanParam(name: 'PROMOTE_FLAG', value: true),
                              string(name: 'TEAM_DIR', value: '')
                          ],
                          wait: false,
                          propagate: false
                }
            }
        }

        always {
            script {
                def artifactPatterns = ['*.log']
                def configuredArtifacts = (params.FILES_TO_UPLOAD ?: '').trim()

                if (configuredArtifacts) {
                    artifactPatterns << configuredArtifacts
                }

                artifactPatterns << 'javascript-coverage-sbom.json'
                if (!params.IS_CHENGDU) {
                    artifactPatterns << 'javascript-coverage.wiki'
                }

                archiveArtifacts artifacts: artifactPatterns.join(','), allowEmptyArchive: true
            }
        }

        failure {
            script {
                def recipients = ((params.NOTIFY_RECIPIENTS ?: '') as String).trim()
                if (!recipients) {
                    recipients = ((env.NOTIFY_RECIPIENTS ?: '') as String).trim()
                }

                def recipientList = parseRecipientList(recipients)
                if (recipientList.isEmpty()) {
                    echo 'NOTIFY_RECIPIENTS is empty; skipping failure email.'
                    return
                }

                def logPaths = ['build.log', 'upload.log']
                def failureReason = 'unknown'
                for (String logPath : logPaths) {
                    def reason = extractFailureReason(logPath)
                    if (reason != 'unknown') {
                        failureReason = reason
                        break
                    }
                }

                mail(
                    to: recipientList.join(','),
                    subject: "[javascript-coverage] Job failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """\
                        Job failed.

                        Build URL: ${env.BUILD_URL}
                        Failure Reason: ${failureReason}

                        Artifacts:
                        - ${env.BUILD_URL}artifact/${params.FILES_TO_UPLOAD}
                        """.stripIndent()
                )
            }
        }
    }
}
