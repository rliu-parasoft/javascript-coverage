pipeline {
    agent { label 'JSC-Builder' }

    environment {
        BITBUCKET_API = 'https://code.parasoftcn.com/rest/api/latest/projects/JSC/repos/javascript-coverage'
        PR_FILE_PATH_RULES = 'jenkins/scripts/pr-path-rules.json'
    }

    parameters {
        string(
            name: 'JTEST_HOME',
            defaultValue: 'C:/Parasoft/jtest_2026.1.1'
        )

        string(
            name: 'DTP_URL',
            defaultValue: 'https://dtp.parasoftcn.com/',
            description: 'DTP server URL'
        )

        string(
            name: 'DTP_USER',
            defaultValue: 'admin',
            description: 'DTP username'
        )

        password(
            name: 'DTP_PASSWORD',
            defaultValue: 'tHBISrPrxc83P8Bp5reosw==',
            description: 'DTP password'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'jscov-bitbucket-pr-bot', usernameVariable: 'API_USERNAME', passwordVariable: 'API_PASSWORD')
                ]) {
                    sh 'bash jenkins/scripts/analyze-pr-changes.sh'
                }
            }
        }

        stage('Load Execution Plan') {
            steps {
                script {
                    def lines = readFile('artifacts/steps.csv').readLines().findAll { it.trim() }
                    def headers = lines[0].replace('"', '').split(',')
                    def values  = lines[1].split(',')
                    headers.eachWithIndex { key, i ->
                        env."${key}" = values[i]
                        echo "${key}=${env."${key}"}"
                    }
                }
            }
        }

        stage('Static Analysis (Java)') {
            when {
                expression { env.NEED_JAVA_SA == 'true' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'bash jenkins/scripts/run-java-static-analysis.sh'
                }
                recordIssues(
                    enabledForFailure: true,
                    tools: [
                        parasoftFindings(
                            id: 'jtest-static-analysis',
                            name: 'Jtest Static Analysis',
                            pattern: 'artifacts/static/java/report/report.xml',
                            localSettingsPath: 'jenkins/scripts/jtest.properties'
                        )
                    ],
                    qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]]
                )
            }
        }

        stage('Static Analysis (JavaScript)') {
            when {
                expression { env.NEED_JS_SA == 'true' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'bash jenkins/scripts/run-js-static-analysis.sh'
                }
                recordIssues(
                    enabledForFailure: true,
                    tools: [
                        checkStyle(
                            id: 'eslint-static-analysis',
                            name: 'ESLint Static Analysis',
                            pattern: 'artifacts/static/js/**/checkstyle.xml'
                        )
                    ],
                    qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]]
                )
            }
        }
    }

    // ------------------------------------------------------------------
    // TODO: downstream stages consume the pre-analysis result.
    //
    // Read `artifacts/steps.csv` FIRST (line 1 = headers, line 2 = values)
    // and get the six flags:
    //   NEED_JS_TEST_TIA     — JS test/src changed; run FULL JS tests since there is no TIA for JS(mocha)
    //   NEED_JS_TEST_FULL    — JS build/dependency config changed; run the FULL JS tests(mocha)
    //   NEED_JAVA_TEST_TIA   — Java test/src changed; run TIA Java tests(Jtest)
    //   NEED_JAVA_TEST_FULL  — Java build/dependency config changed; run the full Java tests(Jtest)
    //   NEED_JS_SA           — JS static analysis(ESLint) must be re-run
    //   NEED_JAVA_SA         — Java static analysis(Jtest) must be re-run
    //
    // Rule: NEED_JS_TEST_* and NEED_JAVA_TEST_* are groups,
    //       FULL wins over TIA which means is *_FULL is true the full tests must be re-run
    //       no matter what the value of *_TIA is.
    // ------------------------------------------------------------------

    post {
        always {
            script {
                env.PR_BUILD_RESULT = currentBuild.currentResult ?: 'SUCCESS'
            }
            withCredentials([
                usernamePassword(credentialsId: 'jscov-bitbucket-pr-bot', usernameVariable: 'API_USERNAME', passwordVariable: 'API_PASSWORD')
            ]) {
                sh 'bash jenkins/scripts/post-pr-summary.sh'
            }
            archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: true, fingerprint: false
        }
    }
}
