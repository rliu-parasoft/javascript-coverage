pipeline {
    agent { label 'JSC-Builder' }

    environment {
        BITBUCKET_API = 'https://code.parasoftcn.com/rest/api/latest/projects/JSC/repos/javascript-coverage'
        PR_FILE_PATH_RULES = 'jenkins/scripts/pr-path-rules.json'
    }

    parameters {
        string(
            name: 'JTEST_HOME',
            defaultValue: 'C:/Parasoft/jtest_2026.1.1'
        )

        string(
            name: 'DTP_URL',
            defaultValue: 'https://dtp.parasoftcn.com/',
            description: 'DTP server URL'
        )

        string(
            name: 'DTP_USER',
            defaultValue: 'admin',
            description: 'DTP username'
        )

        password(
            name: 'DTP_PASSWORD',
            defaultValue: 'tHBISrPrxc83P8Bp5reosw==',
            description: 'DTP password'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'jscov-bitbucket-pr-bot', usernameVariable: 'API_USERNAME', passwordVariable: 'API_PASSWORD')
                ]) {
                    sh 'bash jenkins/scripts/analyze-pr-changes.sh'
                }
            }
        }

        stage('Load Execution Plan') {
            steps {
                script {
                    def lines = readFile('artifacts/steps.csv').readLines().findAll { it.trim() }
                    def headers = lines[0].replace('"', '').split(',')
                    def values  = lines[1].split(',')
                    headers.eachWithIndex { key, i ->
                        env."${key}" = values[i]
                        echo "${key}=${env."${key}"}"
                    }
                }
            }
        }

        stage('Static Analysis (Java)') {
            when {
                expression { env.NEED_JAVA_SA == 'true' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'bash jenkins/scripts/run-java-static-analysis.sh'
                }
                recordIssues(
                    enabledForFailure: true,
                    tools: [
                        parasoftFindings(
                            id: 'jtest-static-analysis',
                            name: 'Jtest Static Analysis',
                            pattern: 'artifacts/reports/static-analysis/java/report.xml',
                            localSettingsPath: 'jenkins/scripts/jtest.properties'
                        )
                    ],
                    qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]]
                )
            }
        }

        stage('Static Analysis (JavaScript)') {
            when {
                expression { env.NEED_JS_SA == 'true' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'bash jenkins/scripts/run-js-static-analysis.sh'
                }
                recordIssues(
                    enabledForFailure: true,
                    tools: [
                        checkStyle(
                            id: 'eslint-static-analysis',
                            name: 'ESLint Static Analysis',
                            pattern: 'artifacts/reports/static-analysis/js/**/checkstyle.xml'
                        )
                    ],
                    qualityGates: [[threshold: 1, type: 'TOTAL', unstable: true]]
                )
            }
        }

        stage('Test Execution (Java)') {
            when {
                expression { env.NEED_JAVA_TEST_TIA == 'true' || env.NEED_JAVA_TEST_FULL == 'true' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'bash jenkins/scripts/run-java-tests.sh'
                }
                recordParasoftCoverage(
                    pattern: 'artifacts/reports/unit-tests/java/**/coverage.xml',
                    sourceCodeEncoding: 'UTF-8'
                )
                xunit(
                    thresholds: [
                        failed(unstableThreshold: '0'),
                        skipped(unstableThreshold: '0')
                    ],
                    tools: [JUnit(
                        pattern: 'artifacts/reports/unit-tests/java/**/junit/*.xml',
                        deleteOutputFiles: false,
                        failIfNotNew: false,
                        skipNoTestFiles: true,
                        stopProcessingIfError: true
                    )]
                )
            }
        }

        stage('Test Execution (JavaScript)') {
            when {
                expression { env.NEED_JS_TEST_TIA == 'true' || env.NEED_JS_TEST_FULL == 'true' }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    sh 'bash jenkins/scripts/run-js-tests.sh'
                }
                recordCoverage(
                    id: 'js-coverage',
                    name: 'Javascript Coverage',
                    enabledForFailure: true,
                    failOnError: false,
                    tools: [[parser: 'CLOVER', pattern: 'artifacts/reports/unit-tests/js/**/coverage/clover.xml']]
                )
                xunit(
                    thresholds: [
                        failed(unstableThreshold: '0'),
                        skipped(unstableThreshold: '4')
                    ],
                    tools: [JUnit(
                        pattern: 'artifacts/reports/unit-tests/js/**/test/report.xml',
                        deleteOutputFiles: false,
                        failIfNotNew: true,
                        skipNoTestFiles: false,
                        stopProcessingIfError: true
                    )]
                )
            }
        }
    }

    post {
        always {
            script {
                env.PR_BUILD_RESULT = currentBuild.currentResult ?: 'SUCCESS'
            }
            sh 'bash jenkins/scripts/build-summary.sh'
            withCredentials([
                usernamePassword(credentialsId: 'jscov-bitbucket-pr-bot', usernameVariable: 'API_USERNAME', passwordVariable: 'API_PASSWORD')
            ]) {
                sh 'bash jenkins/scripts/post-pr-summary.sh'
            }
            archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: true, fingerprint: false
        }
    }
}
